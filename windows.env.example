NODE_ENV=production
SERVE_DIST=1
API_HOST=127.0.0.1
API_PORT=8080
APP_USER=admin
APP_PASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=jingshan
PGUSER=jingshan
PGPASSWORD=
TZ=Asia/Shanghai

# Optional CIM service origin. An approved self-signed certificate also requires its exact HTTPS origin and SHA-256 fingerprint.
CIM_SERVICE_ORIGIN=
# Trusted external GeoJSON and ArcGIS FeatureServer origins, comma-separated (scheme, host, optional port).
CIM_FEATURE_ORIGINS=
CIM_TLS_ORIGIN=
CIM_TLS_SHA256=

# Optional certificate pin for one WMS GetCapabilities / GetMap endpoint (exact HTTPS URL without query).
CIM_WMS_TLS_ENDPOINT=
CIM_WMS_TLS_SHA256=
